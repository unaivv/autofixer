# --- Atlassian (Jira Cloud + Bitbucket Cloud) ---
ATLASSIAN_EMAIL=you@company.com
ATLASSIAN_API_TOKEN=

JIRA_BASE_URL=https://your-domain.atlassian.net

# Simple JQL (leave JIRA_JQL empty to auto-build from the fields below)
JIRA_PROJECT=APP
JIRA_ISSUE_TYPE=Bug
JIRA_STATUS=To Do
JIRA_LABEL_AI_FIXABLE=ai-fixable
# JIRA_JQL=project = APP AND issuetype = Bug AND status = "To Do" AND labels = ai-fixable ORDER BY created ASC

# After a successful PR, transition issue to this status name (must exist on your workflow)
JIRA_TRANSITION_IN_REVIEW=In Review

# --- Single Bitbucket repository (Cloud) ---
BITBUCKET_WORKSPACE=your-workspace
BITBUCKET_REPO_SLUG=your-repo
# Optional: full HTTPS clone URL (if set, overrides workspace/slug construction)
# BITBUCKET_GIT_CLONE_URL=https://...

# --- Git HTTPS (clone/push) — often NOT the same as Jira-only ATATT tokens ---
# If clone fails with "Authentication failed", create a token IN BITBUCKET:
# Repository settings → Security → Access tokens (or Workspace access token) with
# repository read + write, then:
BITBUCKET_GIT_ACCESS_TOKEN=
# That uses https://x-token-auth:<token>@bitbucket.org/... for Git, and Bearer for Bitbucket REST (PRs).
# When creating the token, enable at least: repository (read), repository:write, pullrequest:write.

# Alternative: Bitbucket *username* + *app password* (no BITBUCKET_GIT_ACCESS_TOKEN):
# BITBUCKET_GIT_HTTPS_USERNAME=your_bitbucket_username
# and put the app password in ATLASSIAN_API_TOKEN only if you use a dedicated .env for git
# (or set BITBUCKET_GIT_CLONE_URL with the full HTTPS URL from Bitbucket "Clone").
# BITBUCKET_GIT_HTTPS_USERNAME=

# --- Runtime ---
# Omit on Windows to use %TEMP%\ai_agent_runs; on Linux/macOS you may use /tmp/ai_agent_runs
# WORKSPACE_ROOT=
MAX_DAILY_ISSUES=5
DEFAULT_BRANCH=develop
PR_TARGET_BRANCH=develop

# Agent CLI (shlex-split). Default feeds the combined prompt on stdin.
# Most installs use `claude` (not `claude-code`). If Python says "not on PATH", paste the
# full path from:  where claude   (Windows)   or   which claude   (macOS/Linux)
# AGENT_COMMAND=C:\Users\YOU\AppData\Local\Programs\...\claude.exe run --dangerously-skip-permissions
AGENT_COMMAND=claude run --dangerously-skip-permissions
# Live agent output on the console while it runs (default true). false = capture only at end.
# AGENT_STREAM_OUTPUT=false

DOCKER_NODE_IMAGE=node:20-bookworm

# Optional: validate only, no push / PR / Jira transition
DRY_RUN=false

SLACK_WEBHOOK=

# Guardrails (generous defaults)
MAX_FILES_CHANGED=50
MAX_LINES_CHANGED=5000
CLASSIFIER_MIN_SCORE=60
CONFIDENCE_MIN_APPROVE=80

# Turborepo: validate only packages touched by the patch (default true). Set false for full graph.
# VALIDATION_TURBO_FILTER_CHANGED=false
